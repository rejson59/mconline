{
  "name": "blockcraft",
  "private": true,
  "version": "2.33.0",
  "description": "BlockCraft 2.33 „Zombies 1:1 – Dead End, Bad Blood, Alien Arcadium i Prison” – polska gra sandboxowa w przeglądarce z trybem Zombies jak na Hypixelu: 4 mapy 1:1, 30 rund, drzwi 500-1250g, perki, Mystery Chest i Ultimate Machine, bronie palne (Pistol/Rifle/Shotgun/Sniper/Rocket + Elder Gun/Zapper/Gold Digger) i publiczny serwer. Bez instalacji i bez konta.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "minecraft",
    "voxel",
    "browser-game",
    "threejs",
    "vite",
    "react",
    "github-pages"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node .harness/run.mjs",
    "test:engine": "node .harness/run.mjs smoke",
    "test:ui": "node .harness/run.mjs ui",
    "deploy:branch": "npm run build && npx --yes gh-pages -d dist"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "2.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
