{
  "name": "minecraft-browser",
  "private": true,
  "version": "4.44.0",
  "description": "Minecraft — nieoficjalna wersja przeglądarkowa, survival i wspólne miasto Creative",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "minecraft",
    "voxel",
    "browser-game",
    "threejs",
    "vite",
    "react",
    "github-pages"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --test scripts/portal-bootstrap.test.mjs scripts/account-bootstrap.test.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node .harness/run.mjs && node --test scripts/portal-bootstrap.test.mjs scripts/account-bootstrap.test.mjs && node scripts/test-shared-state-sql.mjs && node scripts/test-shared-mobs-sql.mjs && node --test scripts/audit-java-reference.test.mjs scripts/probe-reference-network.test.mjs && node --test scripts/reference-storage.test.mjs && node --test scripts/reference-reader.test.mjs && node --test scripts/reference-corpus.test.mjs && node --test scripts/reference-transfer.test.mjs && node --test scripts/reference-archive.test.mjs && node --test scripts/reference-embedded.test.mjs && node scripts/test-trapdoor-state-sql.mjs && node --test scripts/parity-progress.test.mjs && npm run progress:check",
    "test:trappose": "node .harness/run.mjs trappose",
    "test:browser:trappose": "BROWSER_TRAP_POSE=1 node scripts/verify-panels-browser.mjs",
    "test:browser:cubepose": "BROWSER_CUBE_POSE=1 node scripts/verify-panels-browser.mjs",
    "test:cubepose": "node .harness/run.mjs cubepose",
    "test:browser:recovery": "BROWSER_PROFILE_RECOVERY=1 node scripts/verify-multiplayer-lease-browser.mjs",
    "test:remotehands": "node .harness/run.mjs remotehands",
    "test:browser:remotehands": "BROWSER_REMOTE_HANDS=1 node scripts/verify-panels-browser.mjs",
    "test:native": "node .harness/run.mjs native",
    "test:fire": "node .harness/run.mjs fire",
    "test:engine": "node .harness/run.mjs smoke",
    "test:browser:native": "node scripts/verify-native-browser.mjs",
    "test:browser:fire": "node scripts/verify-fire-browser.mjs",
    "test:browser:meshing": "node scripts/verify-meshing-browser.mjs",
    "test:meshing": "node .harness/run.mjs meshing",
    "test:ui": "node .harness/run.mjs ui",
    "deploy:branch": "npm run build && npx --yes gh-pages -d dist",
    "bench:meshing": "node scripts/bench-meshing.mjs",
    "test:furnace": "node .harness/run.mjs furnace",
    "test:browser:furnace": "BROWSER_FURNACE=1 node scripts/verify-native-browser.mjs",
    "test:facing": "node .harness/run.mjs facing",
    "test:browser:facing": "BROWSER_FACING=1 node scripts/verify-native-browser.mjs",
    "test:panorama": "node .harness/run.mjs panorama",
    "test:browser:panorama": "node scripts/verify-panorama-browser.mjs",
    "test:account": "node .harness/run.mjs account",
    "test:browser:account": "node scripts/verify-account-browser.mjs",
    "test:cloud": "node .harness/run.mjs cloud",
    "test:browser:cloud": "node scripts/verify-cloud-browser.mjs",
    "test:cloud:live": "node scripts/verify-cloud-live.mjs",
    "test:lease": "node .harness/run.mjs lease",
    "test:browser:lease": "node scripts/verify-multiplayer-lease-browser.mjs",
    "test:checkpoint": "node .harness/run.mjs checkpoint",
    "test:browser:reports": "node scripts/verify-report-fixes-browser.mjs",
    "test:shared": "node .harness/run.mjs shared && node scripts/test-shared-state-sql.mjs && node scripts/test-shared-mobs-sql.mjs",
    "test:browser:shared": "node scripts/verify-shared-state-browser.mjs",
    "test:browser:survival": "BROWSER_SURVIVAL=1 node scripts/verify-refinements-browser.mjs",
    "test:heldlighting": "node .harness/run.mjs heldlighting",
    "test:browser:heldlighting": "node scripts/verify-held-lighting-browser.mjs",
    "test:survival": "node .harness/run.mjs survival",
    "reference:survival": "node scripts/sync-survival-reference.mjs",
    "test:reports442": "node .harness/run.mjs reports442",
    "test:browser:reports442": "BROWSER_REPORTS442=1 node scripts/verify-refinements-browser.mjs",
    "test:refinements": "node .harness/run.mjs refinements",
    "test:browser:refinements": "node scripts/verify-refinements-browser.mjs",
    "reference:sync": "node scripts/audit-java-reference.mjs",
    "reference:audit": "node scripts/audit-java-reference.mjs --offline",
    "test:reference": "node --test scripts/audit-java-reference.test.mjs",
    "test:reference:network": "node --test scripts/probe-reference-network.test.mjs",
    "test:reference:storage": "node --test scripts/reference-storage.test.mjs",
    "test:browser:reference:storage": "node scripts/verify-reference-storage-browser.mjs",
    "test:reference:reader": "node --test scripts/reference-reader.test.mjs",
    "test:reference:corpus": "node --test scripts/reference-corpus.test.mjs",
    "reference:corpus": "node scripts/reference-corpus.mjs",
    "test:reference:transfer": "node --test scripts/reference-transfer.test.mjs",
    "test:reference:archive": "node --test scripts/reference-archive.test.mjs",
    "test:reference:embedded": "node --test scripts/reference-embedded.test.mjs",
    "test:movement": "node .harness/run.mjs movement",
    "test:fences": "node .harness/run.mjs fences",
    "test:browser:fences": "node scripts/verify-fences-browser.mjs",
    "test:panels": "node .harness/run.mjs panels",
    "test:browser:panels": "node scripts/verify-panels-browser.mjs",
    "test:traps": "node .harness/run.mjs traps",
    "test:traps:sql": "node scripts/test-trapdoor-state-sql.mjs",
    "test:browser:traps": "BROWSER_TRAPS=1 node scripts/verify-panels-browser.mjs",
    "test:trapuv": "node .harness/run.mjs trapuv",
    "test:browser:trapuv": "BROWSER_TRAP_UV=1 node scripts/verify-panels-browser.mjs",
    "test:trapitem": "node .harness/run.mjs trapitem",
    "test:browser:trapitem": "BROWSER_TRAP_ITEM=1 node scripts/verify-panels-browser.mjs",
    "test:landscape": "node .harness/run.mjs landscape",
    "test:browser:landscape": "node scripts/verify-landscape-browser.mjs",
    "progress:audit": "node scripts/parity-progress.mjs",
    "progress:check": "node scripts/parity-progress.mjs --check-runtime",
    "test:progress": "node --test scripts/parity-progress.test.mjs",
    "test:mobmotion": "node .harness/run.mjs mobmotion",
    "test:browser:mobmotion": "node scripts/verify-mob-motion-browser.mjs"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.28.2",
    "jose": "6.2.15",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "2.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
