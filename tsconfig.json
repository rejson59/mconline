{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["node", "vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", ".harness/movement.ts", ".harness/fences.ts", ".harness/profileCheckpoint.ts", ".harness/multiplayerLease.ts", ".harness/cloud.ts", ".harness/panorama.tsx", "vite.config.ts", ".harness/perf.ts", ".harness/meshing.ts", ".harness/fire.ts", ".harness/nativeAudit.ts", ".harness/furnace.ts", ".harness/facing.ts", ".harness/smoke.ts", ".harness/ui.tsx", ".harness/account.tsx", ".harness/bench.ts", ".harness/jsdom.d.ts"]
}
